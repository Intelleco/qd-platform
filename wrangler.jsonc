{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qd-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "QD_ALLOWED_ORIGINS": "https://qd.org,https://www.qd.org,http://localhost:5173"
  },
  "r2_buckets": [
    {
      "binding": "QD_CORPUS",
      "bucket_name": "qd-data"
    }
  ],
  "routes": [
    {
      "pattern": "api.qd.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
